{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adffirstcase"
		},
		"isDatalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'isDatalake'"
		},
		"isSQLdb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'isSQLdb'"
		},
		"isDatalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://safirstcase.dfs.core.windows.net/"
		},
		"isSQLdb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverfirstcase.database.windows.net"
		},
		"isSQLdb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbfirstdb"
		},
		"isSQLdb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminfirst"
		},
		"ls_rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adffirstcase_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"isDatalake_accountKey": {
						"value": "[parameters('isDatalake_accountKey')]"
					},
					"isSQLdb_password": {
						"value": "[parameters('isSQLdb_password')]"
					},
					"isDatalake_properties_typeProperties_url": {
						"value": "[parameters('isDatalake_properties_typeProperties_url')]"
					},
					"isSQLdb_properties_typeProperties_server": {
						"value": "[parameters('isSQLdb_properties_typeProperties_server')]"
					},
					"isSQLdb_properties_typeProperties_database": {
						"value": "[parameters('isSQLdb_properties_typeProperties_database')]"
					},
					"isSQLdb_properties_typeProperties_userName": {
						"value": "[parameters('isSQLdb_properties_typeProperties_userName')]"
					},
					"ls_rest_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}